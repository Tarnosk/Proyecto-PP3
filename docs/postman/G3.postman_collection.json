    {
      "name": "14 - Protección contra Stock Negativo en Venta G4 (POST /api/stock/movimientos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400 Bad Request al intentar descontar más stock del disponible', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "const json = pm.response.json();",
