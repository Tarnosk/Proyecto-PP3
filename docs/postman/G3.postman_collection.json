    {
      "name": "01 - Índice de Endpoints de Integración G3 (GET /api)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Lista los endpoints de integración para G1, G2 y G4', function () {",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.endpoints).to.be.an('array').that.is.not.empty;",
              "    pm.expect(json.endpoints).to.include('GET /api/productos');",
              "    pm.expect(json.endpoints).to.include('GET /api/stock/{id}');",
              "    pm.expect(json.endpoints).to.include('POST /api/stock/movimientos');",
              "    pm.expect(json.endpoints).to.include('POST /api/stock/devoluciones');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api"
          ]
        }
      }
    },
    {
      "name": "02 - Catálogo de Productos Activos para G4 Ventas y G1 (GET /api/productos?estado=activo)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Estructura paginada válida con productos activos', function () {",
              "    pm.expect(json.status).to.eql('success');",
              "    pm.expect(json.data).to.be.an('array').that.is.not.empty;",
              "});",
              "const prod = json.data.find(p => p.stock_disponible >= 5) || json.data[0];",
              "pm.collectionVariables.set('id_producto', String(prod.id_producto));",
              "pm.collectionVariables.set('codigo_producto', String(prod.codigo));",
              "if (prod.id_categoria) pm.collectionVariables.set('id_categoria', String(prod.id_categoria));",
              "if (prod.id_marca) pm.collectionVariables.set('id_marca', String(prod.id_marca));",
              "pm.collectionVariables.set('stock_inicial', String(prod.stock_disponible));",
              "",
              "pm.test('Contrato comercial completo para G1, G2 y G4', function () {",
              "    pm.expect(prod).to.have.property('id');",
              "    pm.expect(prod).to.have.property('id_producto');",
              "    pm.expect(prod.id).to.eql(prod.id_producto);",
              "    pm.expect(prod).to.have.property('codigo');",
              "    pm.expect(prod).to.have.property('nombre');",
              "    pm.expect(prod).to.have.property('descripcion');",
              "    pm.expect(prod).to.have.property('precio_unitario');",
              "    pm.expect(prod).to.have.property('precio_mayorista');",
              "    pm.expect(prod).to.have.property('precio_minorista');",
              "    pm.expect(prod).to.have.property('precioMay');",
              "    pm.expect(prod).to.have.property('precioMin');",
              "    pm.expect(prod).to.have.property('stock');",
              "    pm.expect(prod).to.have.property('stock_disponible');",
              "    pm.expect(prod).to.have.property('stock_minimo');",
              "    pm.expect(prod).to.have.property('formato_bulto');",
              "    pm.expect(prod).to.have.property('unidades_por_bulto');",
              "    pm.expect(prod).to.have.property('presentacion_texto');",
              "    pm.expect(prod.estado).to.eql('activo');",
              "});",
              "pm.test('Precio neto de venta unificado (precio_unitario == precioMay == precioMin)', function () {",
              "    pm.expect(prod.precio_unitario).to.be.above(0);",
              "    pm.expect(prod.precioMay).to.eql(prod.precio_unitario);",
              "    pm.expect(prod.precioMin).to.eql(prod.precio_unitario);",
              "});",
              "pm.test('Oculta datos internos confidenciales de G3 hacia otros grupos', function () {",
              "    pm.expect(prod).to.not.have.property('costo');",
              "    pm.expect(prod).to.not.have.property('recargo');",
              "    pm.expect(prod).to.not.have.property('margen_ganancia');",
              "    pm.expect(prod).to.not.have.property('id_usuario_carga');",
              "    pm.expect(prod).to.not.have.property('id_ubicacion');",
              "    pm.expect(prod).to.not.have.property('historial_precios');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
