      "name": "06 - Disponibilidad de Stock de un Producto (G4 HttpStockApi) (GET /api/stock/{id})",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Incluye disponible en raíz (requerido por G4 HttpStockApi)', function () {",
              "    const json = pm.response.json();",
