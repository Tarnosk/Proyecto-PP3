{
  "info": {
    "name": "ERP Juan23 - G1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Importar tambien G1.local.postman_environment.json. Completar credenciales locales. Enviar login primero; el Bearer se guarda automaticamente. No usar Run collection sin querer ejecutar las escrituras reales. Saldo y cobros externos quedan fuera."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const publicRequest = pm.request.auth && pm.request.auth.type === 'noauth';",
          "if (!publicRequest) {",
          "    const token = pm.environment.get('access_token');",
          "    const expiry = pm.environment.get('expires_at');",
          "    if (!token || (expiry && Date.parse(expiry) <= Date.now())) {",
          "        pm.execution.skipRequest();",
          "        throw new Error('Ejecutar primero 01 - Obtener Bearer (POST login).');",
          "    }",
          "}",
          "const rawUrl = pm.request.url.toString();",
          "for (const key of ['cliente_id', 'reclamo_id', 'producto_id', 'usuario_id', 'cliente_creado_id', 'reclamo_creado_id']) {",
          "    if (rawUrl.includes('{{' + key + '}}') && !/^[1-9][0-9]*$/.test(String(pm.variables.get(key) || ''))) {",
          "        pm.execution.skipRequest();",
          "        throw new Error('Completar ' + key + ' con un ID existente, o ejecutar el alta de prueba correspondiente.');",
          "    }",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Obtener Bearer (POST login)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/login",
        "description": "G1. Las escrituras guardan cambios reales al pulsar Send.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{{login_json}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['access_token', 'expires_at', 'usuario_id'].forEach(k => pm.environment.unset(k));",
              "const usuario = pm.environment.get('usuario');",
              "const password = pm.environment.get('password');",
              "if (!usuario || !password) {",
              "    pm.execution.skipRequest();",
              "    throw new Error('Completar usuario y password en el entorno G1 local.');",
              "}",
              "pm.variables.set('login_json', JSON.stringify({usuario: usuario, password: password}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "",
              "if (pm.response.code === 200) {",
              "    const data = pm.response.json().data;",
              "    pm.test('Bearer y usuario presentes', function () {",
              "        pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "        pm.expect(data.usuario.id).to.be.a('number');",
              "    });",
              "    if (data.access_token && data.usuario && data.usuario.id) {",
              "        pm.environment.set('access_token', data.access_token);",
              "        pm.environment.set('expires_at', data.expires_at);",
              "        pm.environment.set('usuario_id', String(data.usuario.id));",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
