    {
      "name": "03 - Escrituras REALES (administrativo; ejecutar en orden)",
      "item": [
        {
          "name": "01 - POST cliente de prueba (crea un registro real)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/clientes",
            "description": "G1. Las escrituras guardan cambios reales al pulsar Send.",
            "body": {
              "mode": "raw",
              "raw": "{{cliente_post_json}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "['cliente_creado_id', 'reclamo_creado_id', 'cliente_put_json'].forEach(k => pm.environment.unset(k));",
                  "const documento = String(70000000 + Math.floor(Math.random() * 9999999));",
                  "pm.variables.set('cliente_post_json', JSON.stringify({",
                  "    nombre: 'Prueba', apellido_razon_social: 'Postman G1', tipo_documento: 'dni',",
                  "    dni_cuit: documento, telefono: '2923123456', email: 'prueba.' + documento + '@erp.example',",
                  "    tipo_cliente: 'minorista', localidad: 'Pigue', zona: 'Pruebas API',",
                  "    direccion_calle: 'San Martin', direccion_numero: '150'",
                  "}));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const client = pm.response.json().data;",
                  "    const input = JSON.parse(pm.variables.get('cliente_post_json'));",
                  "    delete input.zona;",
                  "    input.nombre = 'Prueba editada';",
                  "    input.estado = client.estado;",
                  "    input.zona_id = client.zona_id;",
                  "    input.condicion_iva = client.condicion_iva;",
                  "    pm.environment.set('cliente_creado_id', String(client.id));",
                  "    pm.environment.set('cliente_id', String(client.id));",
                  "    pm.environment.set('cliente_put_json', JSON.stringify(input));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - PUT cliente creado (ficha completa)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/clientes/{{cliente_creado_id}}",
            "description": "G1. Las escrituras guardan cambios reales al pulsar Send.",
            "body": {
              "mode": "raw",
              "raw": "{{cliente_put_json}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.environment.get('cliente_put_json')) {",
                  "    pm.execution.skipRequest();",
                  "    throw new Error('Crear primero un cliente desde POST cliente de prueba.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - PATCH cliente creado (telefono)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/clientes/{{cliente_creado_id}}",
            "description": "G1. Las escrituras guardan cambios reales al pulsar Send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"2923445566\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - POST reclamo del cliente creado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/reclamos",
            "description": "G1. Las escrituras guardan cambios reales al pulsar Send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_id\": \"{{cliente_creado_id}}\",\n  \"asunto\": \"Prueba Postman\",\n  \"descripcion\": \"Control de entrega\",\n  \"prioridad\": \"media\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('reclamo_creado_id');",
                  "if (!/^[1-9][0-9]*$/.test(String(pm.environment.get('cliente_creado_id') || ''))) {",
                  "    pm.execution.skipRequest();",
                  "    throw new Error('Crear primero un cliente desde POST cliente de prueba.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const id = String(pm.response.json().data.id);",
                  "    pm.environment.set('reclamo_creado_id', id);",
                  "    pm.environment.set('reclamo_id', id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - PATCH cerrar reclamo creado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/reclamos/{{reclamo_creado_id}}/estado",
            "description": "G1. Las escrituras guardan cambios reales al pulsar Send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"cerrado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Cerrar sesion y limpiar Bearer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/auth/logout",
        "description": "G1. Las escrituras guardan cambios reales al pulsar Send."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "",
              "if (pm.response.code === 200 || pm.response.code === 401) {",
              "    ['access_token', 'expires_at', 'usuario_id'].forEach(k => pm.environment.unset(k));",
              "}"
            ]
          }
        }
      ]
    }
  ]
