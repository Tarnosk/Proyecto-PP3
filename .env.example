APP_NAME="PyB Pigue ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistema_gestion
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Shared only between trusted backend services. Generate a long random value.
INTERNAL_API_TOKEN=
SALES_SERVICE_URL=
SALES_SERVICE_TOKEN=
# La API local de consulta G4 es pública; exigir token cuando el servicio lo requiera.
SALES_AUTH_REQUIRED=false
SALES_HISTORY_PATH=/api/ventas
# Opcionales: vacios = G1 calcula compradores y ranking desde SALES_HISTORY_PATH.
SALES_BUYERS_PATH=
SALES_RANKING_PATH=
CATALOG_SERVICE_URL=
CATALOG_SERVICE_TOKEN=
CATALOG_PRODUCTS_PATH=/api/v1/productos
# G1: hosts de imágenes aprobados, sin esquema ni ruta y separados por coma. Opcional.
CATALOG_IMAGE_HOSTS=
BILLING_SERVICE_URL=
BILLING_SERVICE_TOKEN=
BILLING_PAYMENTS_PATH=/api/v1/cobros
BILLING_INVOICES_PATH=/api/v1/facturas/pendientes
# G1: lectura opcional de cobros incluidos en rendiciones; no sustituye pagos confirmados.
# URL y token del servicio G2 acordados con el equipo. No usar la API local de sesión como Bearer.
G1_RENDICIONES_URL=
G1_RENDICIONES_TOKEN=
G1_RENDICIONES_PATH=/api/v1/rendiciones
BALANCE_SERVICE_URL=
BALANCE_SERVICE_TOKEN=
BALANCE_CLIENT_PATH=/api/v1/clientes/{id}/saldo
BALANCE_DEBTORS_PATH=/api/v1/clientes/deudores

# Integración original de G4. mock simula catálogos y stock, no las escrituras de ventas/pagos.
VENTAS_INTEGRACION=mock
VENTAS_PRODUCTOS_URL=http://localhost:8001
VENTAS_CLIENTES_URL=http://localhost:8002
VENTAS_STOCK_URL=http://localhost:8003
VENTAS_HTTP_TIMEOUT=5
