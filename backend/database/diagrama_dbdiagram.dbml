Project sistema_gestion {
  database_type: "MySQL / MariaDB"
  Note: "Diagrama del dominio de ERP Juan23 migrado a Laravel 12. La tabla tecnica migrations de Laravel no se incluye."
}

Enum rol_usuario {
  administrativo
  repartidor
  contador
}

Enum estado_usuario {
  activo
  inactivo
}

Enum tipo_cliente {
  minorista
  mayorista
}

Enum estado_cliente {
  activo
  inactivo
}

Enum prioridad_reclamo {
  baja
  media
  alta
}

Enum estado_reclamo {
  abierto
  en_proceso
  cerrado
}

Enum estado_producto {
  activo
  inactivo
}

Enum estado_venta {
  pendiente
  confirmada
  pagada
  facturada
  cancelada
}

Enum medio_pago {
  efectivo
  transferencia
  tarjeta
  cheque
  otro
}

Enum estado_cobro {
  confirmado
  anulado
}

Table usuarios {
  id int [pk, increment]
  usuario varchar(50) [not null]
  password_hash varchar(255) [not null]
  nombre varchar(120) [not null]
  email varchar(160)
  rol rol_usuario [not null]
  estado estado_usuario [not null, default: "activo"]
  intentos_fallidos tinyint [not null, default: 0]
  bloqueado_hasta datetime
  ultimo_intento_fallido datetime
  current_session_id varchar(128)
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    usuario [unique, name: "uq_usuarios_usuario"]
    email [unique, name: "uq_usuarios_email"]
  }

  Note: "Usuarios del sistema: administrativo, repartidor y contador. Incluye bloqueo de login y sesion unica."
}

Table password_reset_codes {
  id bigint [pk, increment]
  usuario_id int [not null]
  code_hash varchar(255) [not null]
  intentos tinyint [not null, default: 0]
  expires_at timestamp [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    usuario_id [unique, name: "uq_password_reset_codes_usuario_id"]
  }

  Note: "Codigos temporales hasheados para recuperar contrasenas. Cada usuario puede tener un solo codigo vigente."
}

Table clientes {
  id int [pk, increment]
  nombre varchar(120) [not null]
  apellido_razon_social varchar(160) [not null]
  dni_cuit varchar(20) [not null]
  telefono varchar(30) [not null]
  email varchar(160) [not null]
  direccion varchar(255) [not null]
  localidad varchar(120)
  zona_id int
  condicion_iva varchar(60)
  saldo decimal(12,2) [not null, default: 0]
  tipo_cliente tipo_cliente [not null]
  estado estado_cliente [not null, default: "activo"]
  creado_por int [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    dni_cuit [unique, name: "uq_clientes_dni_cuit"]
    email [unique, name: "uq_clientes_email"]
    creado_por [name: "idx_clientes_creado_por"]
  }

  Note: "Clientes registrados. creado_por guarda el administrador que dio de alta el cliente. updated_at se actualiza automaticamente en MySQL."
}

Table zonas {
  id int [pk, increment]
  nombre varchar(120) [not null, unique]
  descripcion varchar(255)

  Note: "Equivale a ZONA del diagrama general."
}

Table categorias {
  id int [pk, increment]
  nombre varchar(120) [not null, unique]
  created_at timestamp
  updated_at timestamp
}

Table marcas {
  id int [pk, increment]
  nombre varchar(120) [not null, unique]
  created_at timestamp
  updated_at timestamp
}

Table productos {
  id int [pk, increment]
  codigo varchar(60) [not null, unique]
  nombre varchar(160) [not null]
  descripcion text
  precio_mayorista decimal(12,2) [not null, default: 0]
  precio_minorista decimal(12,2) [not null, default: 0]
  imagen varchar(255)
  stock int [not null, default: 0]
  stock_minimo int [not null, default: 0]
  dias_alerta_vencimiento int [not null, default: 30]
  estado estado_producto [not null, default: "activo"]
  categoria_id int
  marca_id int
  usuario_id int
  created_at timestamp
  updated_at timestamp

  indexes {
    (stock, stock_minimo) [name: "idx_productos_stock_bajo"]
  }

  Note: "Equivale a PRODUCTO. Los nombres camelCase se normalizan a snake_case en Laravel."
}

Table ventas {
  id int [pk, increment]
  cliente_id int [not null]
  fecha datetime [not null]
  total decimal(12,2) [not null]
  numero_factura varchar(80)
  estado estado_venta [not null, default: "pendiente"]
  observaciones text
  usuario_id int [not null]
  created_at timestamp
  updated_at timestamp

  indexes {
    fecha [name: "idx_ventas_fecha"]
    (cliente_id, fecha) [name: "idx_ventas_cliente_fecha"]
  }

  Note: "Equivale a VENTA; numero_factura corresponde a numFactura."
}

Table detalle_ventas {
  id int [pk, increment]
  venta_id int [not null]
  producto_id int [not null]
  promocion_id int
  cantidad int [not null]
  precio_unitario decimal(12,2) [not null]
  descuento decimal(12,2) [not null, default: 0]
  subtotal decimal(12,2) [not null]

  Note: "Equivale a DETALLE_VENTA. promocion_id queda preparado para promociones."
}

Table cobros {
  id int [pk, increment]
  cliente_id int [not null]
  usuario_id int [not null]
  fecha datetime [not null]
  monto_total decimal(12,2) [not null]
  medio_pago medio_pago [not null]
  comprobante_nro varchar(100)
  estado estado_cobro [not null, default: "confirmado"]
  observaciones text
  anulado_en datetime
  anulado_por int
  motivo_anulacion varchar(255)
  created_at timestamp
  updated_at timestamp

  indexes {
    (cliente_id, fecha) [name: "idx_cobros_cliente_fecha"]
  }

  Note: "Equivale a COBRO y registra pagos totales o parciales."
}

Table cobro_ventas {
  cobro_id int [not null]
  venta_id int [not null]
  monto_aplicado decimal(12,2) [not null]

  indexes {
    (cobro_id, venta_id) [pk]
  }

  Note: "Equivale a COBRO_VENTA y distribuye un pago entre ventas."
}

Table login_logs {
  id int [pk, increment]
  usuario_id int [not null]
  fecha_hora timestamp [not null, default: `CURRENT_TIMESTAMP`]
  ip varchar(45)

  indexes {
    usuario_id [name: "idx_login_logs_usuario_id"]
  }

  Note: "Historial de inicios de sesion exitosos."
}

Table reclamos {
  id int [pk, increment]
  cliente_id int [not null]
  usuario_id int [not null]
  asunto varchar(160) [not null]
  descripcion text [not null]
  prioridad prioridad_reclamo [not null, default: "media"]
  estado estado_reclamo [not null, default: "abierto"]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    cliente_id [name: "idx_reclamos_cliente_id"]
    usuario_id [name: "idx_reclamos_usuario_id"]
    estado [name: "idx_reclamos_estado"]
  }

  Note: "Reclamos cargados por repartidor o administrador, asociados a un cliente. updated_at se actualiza automaticamente en MySQL."
}

Ref fk_clientes_creado_por: clientes.creado_por > usuarios.id [update: cascade, delete: restrict]
Ref fk_clientes_zona: clientes.zona_id > zonas.id [update: cascade, delete: set null]
Ref fk_login_logs_usuario_id: login_logs.usuario_id > usuarios.id [update: cascade, delete: restrict]
Ref fk_password_reset_codes_usuario_id: password_reset_codes.usuario_id > usuarios.id [update: cascade, delete: cascade]
Ref fk_reclamos_cliente_id: reclamos.cliente_id > clientes.id [update: cascade, delete: restrict]
Ref fk_reclamos_usuario_id: reclamos.usuario_id > usuarios.id [update: cascade, delete: restrict]
Ref fk_productos_categoria: productos.categoria_id > categorias.id [update: cascade, delete: set null]
Ref fk_productos_marca: productos.marca_id > marcas.id [update: cascade, delete: set null]
Ref fk_productos_usuario: productos.usuario_id > usuarios.id [update: cascade, delete: set null]
Ref fk_ventas_cliente: ventas.cliente_id > clientes.id [update: cascade, delete: restrict]
Ref fk_ventas_usuario: ventas.usuario_id > usuarios.id [update: cascade, delete: restrict]
Ref fk_detalle_ventas_venta: detalle_ventas.venta_id > ventas.id [update: cascade, delete: cascade]
Ref fk_detalle_ventas_producto: detalle_ventas.producto_id > productos.id [update: cascade, delete: restrict]
Ref fk_cobros_cliente: cobros.cliente_id > clientes.id [update: cascade, delete: restrict]
Ref fk_cobros_usuario: cobros.usuario_id > usuarios.id [update: cascade, delete: restrict]
Ref fk_cobros_anulado_por: cobros.anulado_por > usuarios.id [update: cascade, delete: set null]
Ref fk_cobro_ventas_cobro: cobro_ventas.cobro_id > cobros.id [update: cascade, delete: cascade]
Ref fk_cobro_ventas_venta: cobro_ventas.venta_id > ventas.id [update: cascade, delete: restrict]
